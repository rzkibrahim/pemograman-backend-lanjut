APP_PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=praktikum_backend
DB_SSLMODE=disable
DB_MAX_CONNS=10

# Konfigurasi JWT & Keamanan (Wajib minimal 32 karakter acak)
JWT_SECRET=
JWT_ISSUER=praktikum-backend
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Daftar Origin CORS yang Diizinkan (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
